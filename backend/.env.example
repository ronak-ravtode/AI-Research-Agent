# ---- Application ----
APP_ENV=development
APP_NAME=ai-research-assistant

# ---- Model provider (Groq) ----
# Server-side only. Never prefix with NEXT_PUBLIC_ and never send to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Web search (Tavily) ----
TAVILY_API_KEY=

# ---- Page extraction (Firecrawl) ----
FIRECRAWL_API_KEY=

# ---- Database (Supabase PostgreSQL) ----
# Project Settings -> Database -> Connection string -> URI.
# The password must be URL-encoded (e.g. '#' -> '%23').
# Use the Supabase *pooler* host if you are connecting over IPv4.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Optional: only needed if you call Supabase directly. This app talks to Postgres
# through asyncpg and does not use Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Timeouts (seconds) ----
SEARCH_TIMEOUT=30
SCRAPE_TIMEOUT=45
LLM_TIMEOUT=90

# ---- Per-run limits ----
MAX_SEARCH_QUERIES=4
MAX_SEARCH_RESULTS=8
MAX_EXTRACT_SOURCES=5
MAX_SOURCE_CHARS=6000
MAX_TOTAL_SOURCE_CHARS=20000
